# TASK111 (docs/runbook/TASK111.md, "The scaler's GPU time per mode and
# scale on the M6"): the MetalFX temporal scaler's GPU time per view, the
# metal_stats 2 line's "scaler <t> ms", at r_metalfx_scale 0.34, output
# 1920x1080 windowed, the world pin scenario's settings,
# demo1.dm2 at the engine's own pace, about 14 s, past the first 60 lines.
# Display sync is off and vid_maxfps 300, where TASK111 had it on: at 60
# frames a second on a quiet host the GPU clocks down between frames and
# the pass reads about twice its time, spread over 9 percent between runs
# (docs/runbook/TASK154.md); kept busy it repeats to the microsecond.
adapter=quake2
description=TASK111 MetalFX scaler GPU time: 1920x1080, r_metalfx 2, scale 0.34, display sync off
targets=client game ref_metal
settings=renderer=metal size=1920x1080 fullscreen=0 hidpi=0 vsync=0 maxfps=300 scenario=world pace=own seconds=14 skip=60 cvar.r_metalfx=2 cvar.r_metalfx_scale=0.34 cvar.metal_stats=2
requires=physical-gpu metalfx
runs=3
warmup=1
wall=50
metric=scaler_ms
better=lower
abs_tol=0.03
rel_tol=0.03
accept=0
