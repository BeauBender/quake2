# FIX51 (docs/runbook/FIX51.md, "Round 3 measurements"): the rendered rate of a
# timedemo of demo1.dm2 (its fps line) in ref_metal, 640x480 windowed, r_vsync 1,
# with the stock game settings and metal_stats 1 (the presented and the
# drawable-less frames, counted over the whole run, at the renderer's close).
# FIX51's presented a second over a window of seconds came from a probe
# the engine does not carry, so this case does not reproduce that column.
adapter=quake2
description=FIX51 presents: metal, 640x480 windowed, r_vsync 1, timedemo of demo1.dm2
targets=client game ref_metal
settings=renderer=metal size=640x480 fullscreen=0 vsync=1 pace=timedemo seconds=6 cvar.metal_stats=1
requires=physical-gpu display-hz>=60
runs=3
warmup=1
wall=40
metric=fps
better=higher
abs_tol=0.5
rel_tol=0.01
accept=0
