# TASK111 (docs/runbook/TASK111.md, "The scaler's GPU time per mode and
# scale on the M6"): the MetalFX temporal scaler's GPU time per view, the
# metal_stats 2 line's "scaler <t> ms", at r_metalfx_scale 0.75, output
# 1920x1080 windowed, the world pin scenario's settings,
# demo1.dm2 at the engine's own pace with display sync, about 14 s, past
# the first 60 lines.
adapter=quake2
description=TASK111 MetalFX scaler GPU time: 1920x1080, r_metalfx 2, scale 0.75
targets=client game ref_metal
settings=renderer=metal size=1920x1080 fullscreen=0 hidpi=0 vsync=1 scenario=world pace=own seconds=14 skip=60 cvar.r_metalfx=2 cvar.r_metalfx_scale=0.75 cvar.metal_stats=2
requires=physical-gpu metalfx
runs=3
warmup=1
wall=50
metric=scaler_ms
better=lower
abs_tol=0.03
rel_tol=0.03
accept=0
