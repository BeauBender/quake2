#!/bin/sh
# Commit-time checks, wired by scripts/setup.sh (core.hooksPath=.githooks).
# Fast and offline: conflict markers, game data or build output staged by
# mistake, obvious secrets, agent memory or an embedded repository in the
# index (on every commit), and the other repo invariants when the commit
# touches what they cover. The full gate (scripts/test.sh) still runs
# before a PR.
#
# Usage: runs from git; bypassing it with --no-verify is against the rules
# in CLAUDE.md.
set -eu
cd "$(git rev-parse --show-toplevel)"

fail=0
# Fast, and what it guards (a gitlink, a memory path, the .gitignore rule)
# can arrive under any path or with a deletion, so it runs on every commit.
memcheck=tests/check-no-tracked-memory.sh
"$memcheck" >/dev/null || { "$memcheck" || true; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit "$fail"

bad=$(echo "$staged" | grep -E '\.(pak|pk3|dll|dylib|so|o)$|^(release|debug|build)/' || true)
if [ -n "$bad" ]; then
	echo "pre-commit: game data or build output staged:"; echo "$bad" | sed 's/^/  /'
	fail=1
fi

if git diff --cached -U0 | grep -nE '^\+(<<<<<<<|>>>>>>>)( |$)' >/dev/null; then
	echo "pre-commit: conflict markers in the staged diff"
	fail=1
fi

if git diff --cached -U0 | grep -nE '^\+.*(-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|xox[baprs]-[A-Za-z0-9-]{10,})' >/dev/null; then
	echo "pre-commit: the staged diff looks like it contains a secret"
	fail=1
fi

if echo "$staged" | grep -qE '^(src|doc|docs|tests)/|\.md$|^(Makefile|\.github/)|^\.claude/|^\.gitignore$'; then
	for check in tests/check-*.sh; do
		[ "$check" != "$memcheck" ] || continue
		"$check" >/dev/null || { "$check" || true; fail=1; }
	done
fi

exit "$fail"
