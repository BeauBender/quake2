{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(scripts/test.sh)",
      "Bash(tests/check-savegame-tables.sh)",
      "Bash(tests/check-cvar-docs.sh)",
      "Bash(tests/check-removed-deps.sh)",
      "Bash(tests/check-doc-links.sh)",
      "Bash(make config)"
    ],
    "deny": [
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push origin --delete main:*)",
      "Read(./**/*.pak)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-invariants.sh", "timeout": 60 }
        ]
      }
    ]
  }
}
